{
  "expo": {
    "name": "QLess",
    "slug": "qless",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0E3B1F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.cvsu.qless"
    },
    "android": {
      "package": "edu.cvsu.qless",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E3B1F"
      }
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-status-bar"
    ],
    "icon": "./assets/icon.png",
    "extra": {
      "eas": {
        "projectId": "dfcdd06a-f72a-434a-b5d5-ece304ed68bd"
      }
    }
  }
}
